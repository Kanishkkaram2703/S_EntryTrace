# ============================================================
# S*EntryTrace — Environment Variables
# Copy to .env and adjust as needed
# ============================================================

# Application environment (development | production)
STE_ENVIRONMENT=production

# Safe mode — blocks any write operations to device
STE_SAFE_MODE=true

# ADB executable path (auto-detected in Docker)
# STE_ADB_PATH=/usr/bin/adb

# Evidence storage directory
# STE_EVIDENCE_DIR=/app/evidence

# Reports output directory
# STE_REPORTS_DIR=/app/reports

# Log directory
# STE_LOG_DIR=/app/logs

# Subprocess timeout in seconds
# STE_SUBPROCESS_TIMEOUT=30
